# Bazaar Brief — credentials. Copy this to .env and fill in the blanks.
# .env is gitignored. Never commit real values; never paste them into chat
# (screenshots count).

# --- Public identifiers: safe to keep here, already filled in ---
META_APP_ID=2047384435902693
IG_APP_ID=1113456811263633
# Cross-check only. The publisher resolves the real publishing id from the
# token itself via /me, because Instagram-login tokens use a different id
# namespace than the 17841... Facebook-linked one.
IG_BUSINESS_ACCOUNT_ID=28012998071662181

# --- Secrets: fill these in locally, and add them as GitHub repo Secrets ---
# The long-lived Instagram token from "API setup with Instagram login".
# Lasts 60 days; publish.py --refresh extends it (the workflow does this weekly).
META_LONG_LIVED_TOKEN=

# Only needed if we later switch to the Facebook-login flavour. Leave blank.
META_APP_SECRET=

# --- Kite Connect (₹500/mo) — reliable index + historical data ---
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
